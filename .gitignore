# Generated tiny fixtures — never vendor real weights (see scripts/gen_fixtures.go)
/testdata/fixtures/

# Derived from fixtures by scripts/gen_catalog.go: random per-run signature,
# timestamp, and an absolute local webseed path. Regenerate with `make fixtures`.
/testdata/catalog.json
/testdata/models/

# Fixture bytes copied under web/ by scripts/gen_web_magnets.go
/web/fixtures/

# Go build output
/bin/
/mt
*.test
*.out

# Python
__pycache__/
*.pyc
.venv/
shim/*.egg-info/
.pytest_cache/

# Local model downloads (mt get writes here; never commit GB-scale data)
/downloads/

# Scratch workspace for the seeder pipeline: raw GGUF downloads, cross-compiled
# binaries, and the publisher private seed. Never commit GB-scale data or keys.
/.work/

# `mt get` output dirs and the torrent client's SQLite sidecar
/dest/
.torrent.db
.torrent.db-shm
.torrent.db-wal

# OS / editor noise
.DS_Store
*.swp
.cursor/
